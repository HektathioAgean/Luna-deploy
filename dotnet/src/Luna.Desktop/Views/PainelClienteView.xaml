<UserControl x:Class="Luna.Desktop.Views.PainelClienteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Luna.Apresentacao;assembly=Luna.Apresentacao"
             xmlns:v="clr-namespace:Luna.Desktop.Views">
  <UserControl.Resources>
    <Style x:Key="CelulaNumerica" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <!-- Métricas (componentes.js, metrica): rótulo, valor e a "delta" quando há. -->
    <DataTemplate x:Key="Metrica">
      <Border Style="{StaticResource Etiqueta}" Padding="14,10" Margin="0,0,10,10" MinWidth="150">
        <StackPanel>
          <TextBlock Text="{Binding Rotulo}" FontSize="12" Opacity="0.75" />
          <TextBlock Text="{Binding Valor}" FontSize="22" FontWeight="SemiBold" AutomationProperties.AutomationId="{Binding Rotulo}" />
          <TextBlock Text="{Binding Delta}" FontSize="12" Opacity="0.85" Visibility="{Binding Delta, Converter={StaticResource TemTexto}}" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <ItemsPanelTemplate x:Key="Faixa">
      <WrapPanel />
    </ItemsPanelTemplate>
    <Style x:Key="Atencao" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="36,28">
      <TextBlock Text="Painel do Cliente" Style="{StaticResource Titulo}" />
      <TextBlock Text="Evolução de tempos por cliente" Style="{StaticResource Apoio}" />

      <TextBlock Text="Processe uma base para abrir o painel." Opacity="0.75" AutomationProperties.AutomationId="PainelSemResultado"
                 Visibility="{Binding TemResultado, Converter={StaticResource TemTexto}, ConverterParameter=inverso}" />

      <StackPanel Visibility="{Binding TemResultado, Converter={StaticResource Visivel}}">
        <Border Style="{StaticResource Atencao}" Visibility="{Binding TemClientes, Converter={StaticResource TemTexto}, ConverterParameter=inverso}">
          <TextBlock Text="Não há clientes disponíveis após o processamento." TextWrapping="Wrap" AutomationProperties.AutomationId="PainelSemClientes" />
        </Border>

        <StackPanel Visibility="{Binding TemClientes, Converter={StaticResource Visivel}}">
          <!-- Cliente: buscar, selecionar e a opção do gráfico. -->
          <Border Style="{StaticResource Cartao}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Buscar" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding TextoBusca}"
                         AutomationProperties.AutomationId="BuscaCliente" AutomationProperties.Name="{Binding TextoBusca}" />
                <TextBlock Text="{Binding TextoBusca}" Style="{StaticResource Dica}" />
                <TextBlock Text="{Binding ContagemLista}" Style="{StaticResource Dica}" AutomationProperties.AutomationId="ContagemClientes" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Selecionar" Style="{StaticResource Rotulo}" />
                <!-- Virtualizada: a lista inteira, sem o limite de 300 itens da versão web. -->
                <ListBox ItemsSource="{Binding ClientesFiltrados}" SelectedItem="{Binding ClienteNaLista}" Height="180"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         AutomationProperties.AutomationId="ListaClientes" AutomationProperties.Name="Clientes">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                      <Setter Property="Padding" Value="10,4" />
                      <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                    </Style>
                  </ListBox.ItemContainerStyle>
                </ListBox>
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="Gráfico" Style="{StaticResource Rotulo}" />
                <CheckBox Content="Mostrar rótulos de tempo" IsChecked="{Binding MostrarRotulosTempo}" AutomationProperties.AutomationId="RotulosTempo" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Dia da semana. -->
          <ListBox ItemsSource="{x:Static vm:PainelClienteViewModel.OpcoesDiaSemana}" SelectedItem="{Binding DiaSemana}"
                   ItemsPanel="{StaticResource Faixa}" Background="Transparent" BorderThickness="0" Margin="0,0,0,8"
                   AutomationProperties.AutomationId="DiasSemana" AutomationProperties.Name="Dia da semana">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Margin" Value="0,0,4,4" />
                <Setter Property="AutomationProperties.AutomationId" Value="{Binding}" />
                <Setter Property="AutomationProperties.Name" Value="{Binding}" />
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>

          <TextBlock Text="{Binding Cliente, StringFormat=Carregando {0}...}" Opacity="0.75" Margin="0,0,0,8"
                     Visibility="{Binding Carregando, Converter={StaticResource Visivel}}" AutomationProperties.AutomationId="PainelCarregando" />
          <Border BorderBrush="{DynamicResource SystemFillColorCriticalBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12"
                  Visibility="{Binding MensagemDeErro, Converter={StaticResource TemTexto}}">
            <TextBlock Text="{Binding MensagemDeErro}" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       AutomationProperties.AutomationId="PainelErro" />
          </Border>

          <!-- Painel montado (desenharPainel). -->
          <StackPanel Visibility="{Binding Tela, Converter={StaticResource TemTexto}}">
            <Border Style="{StaticResource Atencao}" Visibility="{Binding Tela.Vazio, Converter={StaticResource Visivel}}">
              <TextBlock Text="{Binding Tela.MensagemVazio}" TextWrapping="Wrap" AutomationProperties.AutomationId="PainelVazio" />
            </Border>

            <StackPanel Visibility="{Binding Tela.Vazio, Converter={StaticResource TemTexto}, ConverterParameter=inverso}">
              <TextBlock Text="{Binding Tela.Apoio}" Style="{StaticResource Apoio}" AutomationProperties.AutomationId="PainelApoio" />
              <ItemsControl ItemsSource="{Binding Tela.Metricas}" ItemTemplate="{StaticResource Metrica}" ItemsPanel="{StaticResource Faixa}"
                            Focusable="False" AutomationProperties.AutomationId="MetricasCliente" />
              <Border Style="{StaticResource Atencao}" Visibility="{Binding Tela.AvisoVolume, Converter={StaticResource TemTexto}}">
                <TextBlock Text="{Binding Tela.AvisoVolume}" TextWrapping="Wrap" AutomationProperties.AutomationId="PainelAvisoVolume" />
              </Border>
              <Border Style="{StaticResource Cartao}" Padding="16,12">
                <StackPanel>
                  <TextBlock Text="{Binding Tela.DicaVolume}" Style="{StaticResource Dica}" Margin="0" AutomationProperties.AutomationId="PainelDicaVolume" />
                  <TextBlock Text="{Binding Tela.DicaReferencias}" Style="{StaticResource Dica}" AutomationProperties.AutomationId="PainelDicaReferencias" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Cartao}">
                <StackPanel>
                  <TextBlock Text="Evolução de tempos e volume" Style="{StaticResource TituloSecao}" />
                  <v:GraficoEntregas Dados="{Binding Painel.Grafico}" Height="540" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Cartao}" Visibility="{Binding Tela.ExibirJanela, Converter={StaticResource Visivel}}">
                <StackPanel>
                  <TextBlock Text="Janela de entrega do cliente" Style="{StaticResource TituloSecao}" />
                  <Border Style="{StaticResource Atencao}" Visibility="{Binding Tela.AvisoJanela, Converter={StaticResource TemTexto}}">
                    <TextBlock Text="{Binding Tela.AvisoJanela}" TextWrapping="Wrap" AutomationProperties.AutomationId="PainelAvisoJanela" />
                  </Border>
                  <ItemsControl ItemsSource="{Binding Tela.MetricasJanela}" ItemTemplate="{StaticResource Metrica}" ItemsPanel="{StaticResource Faixa}"
                                Focusable="False" AutomationProperties.AutomationId="MetricasJanela" />
                  <TextBlock Text="{Binding Tela.DicaJanela}" Style="{StaticResource Dica}" Margin="0,0,0,8"
                             Visibility="{Binding Tela.DicaJanela, Converter={StaticResource TemTexto}}" AutomationProperties.AutomationId="PainelDicaJanela" />
                  <v:GraficoAberturasCliente Dados="{Binding Painel.GraficoAberturas}" Height="430" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Cartao}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="Entregas do cliente" Style="{StaticResource TituloSecao}" />
                  <TextBlock DockPanel.Dock="Top" Text="{Binding Tela.LegendaTabela}" Style="{StaticResource Dica}" Margin="0,0,0,8"
                             AutomationProperties.AutomationId="LegendaTabelaCliente" />
                  <!-- Altura finita dentro da página com rolagem: a grade virtualiza. As duas últimas linhas são o resumo. -->
                  <DataGrid v:ColunasDaTabela.Linhas="{Binding Tela.Tabela}" Height="420"
                            AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                            CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                            EnableRowVirtualization="True" EnableColumnVirtualization="True"
                            VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                            VirtualizingPanel.ScrollUnit="Item" ScrollViewer.CanContentScroll="True"
                            GridLinesVisibility="Horizontal"
                            AutomationProperties.AutomationId="TabelaCliente" AutomationProperties.Name="Entregas do cliente" />
                </DockPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
