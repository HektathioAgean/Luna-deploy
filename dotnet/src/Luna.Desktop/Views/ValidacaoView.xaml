<UserControl x:Class="Luna.Desktop.Views.ValidacaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <!-- Lista de nomes de coluna como etiquetas. -->
    <DataTemplate x:Key="EtiquetaDeColuna">
      <Border Style="{StaticResource Etiqueta}">
        <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" />
      </Border>
    </DataTemplate>
    <ItemsPanelTemplate x:Key="Quebra">
      <WrapPanel />
    </ItemsPanelTemplate>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="36,28" MaxWidth="1000" HorizontalAlignment="Left">
      <TextBlock Text="Validação" Style="{StaticResource Titulo}" />
      <TextBlock Text="Processe uma base para ver a validação." AutomationProperties.AutomationId="ValidacaoSemResultado">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource Apoio}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding TemResultado}" Value="False">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <StackPanel Visibility="{Binding TemResultado, Converter={StaticResource Visivel}}">
        <TextBlock Text="{Binding NomeBase}" Style="{StaticResource Apoio}" />

        <!-- Situação da estrutura -->
        <Border Style="{StaticResource Cartao}">
          <StackPanel>
            <TextBlock AutomationProperties.AutomationId="TextoSituacaoEsquema" FontWeight="SemiBold" TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="Estrutura válida para processamento." />
                  <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Valido}" Value="False">
                      <Setter Property="Text" Value="Estrutura inválida: faltam colunas obrigatórias." />
                      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding AvisoDeDuplicadas}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding AvisoDeDuplicadas, Converter={StaticResource TemTexto}}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Cartao}" Visibility="{Binding ObrigatoriasAusentes, Converter={StaticResource TemTexto}}">
          <StackPanel>
            <TextBlock Text="Colunas obrigatórias ausentes" Style="{StaticResource TituloSecao}" />
            <ItemsControl ItemsSource="{Binding ObrigatoriasAusentes}" ItemTemplate="{StaticResource EtiquetaDeColuna}"
                          ItemsPanel="{StaticResource Quebra}" AutomationProperties.AutomationId="ListaAusentes" />
            <TextBlock Text="Sugestões" Style="{StaticResource TituloSecao}" Margin="0,12,0,6" />
            <ItemsControl ItemsSource="{Binding SugestoesDeCorrecao}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" Margin="0,0,0,4" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Cartao}">
          <UniformGrid Columns="3">
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Obrigatórias encontradas" Style="{StaticResource TituloSecao}" />
              <ItemsControl ItemsSource="{Binding ObrigatoriasEncontradas}" ItemTemplate="{StaticResource EtiquetaDeColuna}" ItemsPanel="{StaticResource Quebra}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Opcionais encontradas" Style="{StaticResource TituloSecao}" />
              <ItemsControl ItemsSource="{Binding OpcionaisEncontradas}" ItemTemplate="{StaticResource EtiquetaDeColuna}" ItemsPanel="{StaticResource Quebra}" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Extras não reconhecidas" Style="{StaticResource TituloSecao}" />
              <ItemsControl ItemsSource="{Binding ColunasDesconhecidas}" ItemTemplate="{StaticResource EtiquetaDeColuna}" ItemsPanel="{StaticResource Quebra}" />
            </StackPanel>
          </UniformGrid>
        </Border>

        <!-- Mensagens de inconsistência -->
        <Border Style="{StaticResource Cartao}">
          <StackPanel>
            <TextBlock Text="Mensagens de inconsistência" Style="{StaticResource TituloSecao}" />
            <ItemsControl ItemsSource="{Binding AvisosDeLeitura}" AutomationProperties.AutomationId="ListaAvisos">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Nenhuma linha inconsistente." Style="{StaticResource Dica}"
                       Visibility="{Binding InconsistenciasPorMotivo, Converter={StaticResource TemTexto}, ConverterParameter=inverso}" />
            <DataGrid ItemsSource="{Binding InconsistenciasPorMotivo}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" MaxHeight="260" Margin="0,4,0,0"
                      Visibility="{Binding InconsistenciasPorMotivo, Converter={StaticResource TemTexto}}"
                      AutomationProperties.AutomationId="TabelaInconsistencias">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Motivo" Binding="{Binding Motivo}" Width="*" />
                <DataGridTextColumn Header="Linhas" Binding="{Binding Linhas, StringFormat=N0}" Width="120" />
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Cartao}">
          <StackPanel>
            <TextBlock Text="Mapeamento aplicado" Style="{StaticResource TituloSecao}" />
            <DataGrid ItemsSource="{Binding Mapeamento}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" MaxHeight="360" AutomationProperties.AutomationId="TabelaMapeamento">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Coluna no arquivo" Binding="{Binding Original}" Width="*" />
                <DataGridTextColumn Header="Coluna padronizada" Binding="{Binding Padronizada}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
