<UserControl x:Class="Luna.Desktop.Views.ExportacaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="36,28" MaxWidth="1000" HorizontalAlignment="Left">
      <TextBlock Text="Exportação" Style="{StaticResource Titulo}" />
      <TextBlock AutomationProperties.AutomationId="ExportacaoApoio">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource Apoio}">
            <Setter Property="Text" Value="{Binding NomeBase}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding TemResultado}" Value="False">
                <Setter Property="Text" Value="Processe uma base para exportar." />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <StackPanel Visibility="{Binding TemResultado, Converter={StaticResource Visivel}}">
        <Border Style="{StaticResource Cartao}">
          <StackPanel>
            <TextBlock Text="Destino" Style="{StaticResource TituloSecao}" />
            <TextBlock Text="Pasta de saída" Style="{StaticResource Rotulo}" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Procurar…" Margin="8,0,0,0" MinWidth="110"
                      Command="{Binding ProcurarPastaCommand}" IsEnabled="{Binding EmExecucao, Converter={StaticResource Negar}}"
                      AutomationProperties.AutomationId="BotaoProcurarPasta" />
              <TextBox Text="{Binding Pasta, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding EmExecucao}"
                       AutomationProperties.AutomationId="CampoPasta" AutomationProperties.Name="Pasta de saída" />
            </DockPanel>
            <TextBlock Text="O nome do arquivo sai do nome da base. Informe só a pasta." Style="{StaticResource Dica}" />
            <StackPanel Margin="0,4,0,0" Visibility="{Binding AlvoExcel, Converter={StaticResource TemTexto}}">
              <TextBlock Text="{Binding AlvoExcel, StringFormat='Excel: {0}'}" Style="{StaticResource Dica}" Margin="0"
                         AutomationProperties.AutomationId="TextoAlvoExcel" />
              <TextBlock Text="{Binding AlvoZip, StringFormat='ZIP: {0}'}" Style="{StaticResource Dica}" Margin="0"
                         AutomationProperties.AutomationId="TextoAlvoZip" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <Button Content="Gravar Excel consolidado" MinWidth="200" Command="{Binding GravarCommand}" CommandParameter="xlsx"
                      Background="{StaticResource LunaExecutar}" Foreground="White"
                      AutomationProperties.AutomationId="BotaoGravarExcel" />
              <Button Content="Gravar ZIP com CSVs" MinWidth="170" Margin="8,0,0,0" Command="{Binding GravarCommand}" CommandParameter="zip"
                      AutomationProperties.AutomationId="BotaoGravarZip" />
            </StackPanel>
            <TextBlock Style="{StaticResource Dica}" Margin="0,8,0,0"
                       Text="Se o arquivo já existir, o Luna pergunta antes de substituir. Progresso, cancelamento e erros ficam na barra de baixo, em qualquer seção." />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Cartao}">
          <StackPanel>
            <TextBlock Text="O que vai no arquivo" Style="{StaticResource TituloSecao}" />
            <ItemsControl ItemsSource="{Binding Conteudo}" AutomationProperties.AutomationId="ConteudoExportacao">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="280" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Rotulo}" Opacity="0.75" />
                    <TextBlock Grid.Column="1" Text="{Binding Valor}" AutomationProperties.AutomationId="{Binding Rotulo, StringFormat='Conteudo {0}'}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Dica}"
                       Text="Excel: uma aba por tabela. ZIP: um CSV por tabela, separador &quot;;&quot; e encoding utf-8-sig." />
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
