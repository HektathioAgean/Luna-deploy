<UserControl x:Class="Luna.Desktop.Views.ResultadosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Luna.Desktop.Views">
  <UserControl.Resources>
    <Style x:Key="CelulaNumerica" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
  </UserControl.Resources>
  <!-- Sem ScrollViewer em volta: a grade precisa de altura finita para virtualizar. -->
  <Grid Margin="36,28,36,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBlock Text="Resultados" Style="{StaticResource Titulo}" />
    <TextBlock Grid.Row="1" AutomationProperties.AutomationId="ResultadosApoio">
      <TextBlock.Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource Apoio}">
          <Setter Property="Text" Value="{Binding NomeBase}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding TemResultado}" Value="False">
              <Setter Property="Text" Value="Processe uma base para ver os resultados." />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <!-- Uma aba por saída, na ordem do motor, numa faixa que quebra linha sem reordenar (o TabControl
         gira as linhas e põe a selecionada embaixo). Sem ordenação nem filtro: mudariam a ordem e
         materializariam a tabela. -->
    <ListBox Grid.Row="2" ItemsSource="{Binding Tabelas}" SelectedItem="{Binding TabelaAtual}"
             Background="Transparent" BorderThickness="0" Margin="0,0,0,8"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             Visibility="{Binding TemResultado, Converter={StaticResource Visivel}}"
             AutomationProperties.AutomationId="AbasResultados" AutomationProperties.Name="Tabelas">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <Setter Property="Padding" Value="12,6" />
          <Setter Property="Margin" Value="0,0,4,4" />
          <Setter Property="AutomationProperties.AutomationId" Value="{Binding Rotulo}" />
          <Setter Property="AutomationProperties.Name" Value="{Binding Titulo}" />
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Titulo}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <ContentControl Grid.Row="3" Content="{Binding TabelaAtual}" Focusable="False"
                    Visibility="{Binding TemResultado, Converter={StaticResource Visivel}}">
      <ContentControl.ContentTemplate>
        <DataTemplate>
          <DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Nota}" Style="{StaticResource Dica}" Margin="0,8,0,0" />
            <TextBlock DockPanel.Dock="Top" Text="Sem dados para exibição." Opacity="0.75"
                       Visibility="{Binding Vazia, Converter={StaticResource Visivel}}"
                       AutomationProperties.AutomationId="TabelaVazia" />
            <DataGrid v:ColunasDaTabela.Linhas="{Binding Linhas}"
                      Visibility="{Binding Vazia, Converter={StaticResource TemTexto}, ConverterParameter=inverso}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Item" ScrollViewer.CanContentScroll="True"
                      GridLinesVisibility="Horizontal"
                      AutomationProperties.AutomationId="GradeResultados" AutomationProperties.Name="{Binding Rotulo}" />
          </DockPanel>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
  </Grid>
</UserControl>
