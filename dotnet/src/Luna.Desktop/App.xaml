<Application x:Class="Luna.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Luna.Desktop.Views"
             ThemeMode="System"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Identidade do Luna (interface/app.css): dourado, barra lateral escura, azul de executar. -->
      <SolidColorBrush x:Key="LunaAcento" Color="#C0A24B" />
      <SolidColorBrush x:Key="LunaLateral" Color="#15191F" />
      <SolidColorBrush x:Key="LunaLateralBorda" Color="#2A3038" />
      <SolidColorBrush x:Key="LunaTextoNoEscuro" Color="#E8EAED" />
      <SolidColorBrush x:Key="LunaTextoNoEscuroApagado" Color="#9AA1AB" />
      <SolidColorBrush x:Key="LunaExecutar" Color="#1D6FE0" />
      <SolidColorBrush x:Key="LunaSucesso" Color="#1A7F37" />
      <SolidColorBrush x:Key="LunaAtencao" Color="#B45309" />
      <SolidColorBrush x:Key="LunaErro" Color="#B91C1C" />
      <v:Negar x:Key="Negar" />
      <v:TemConteudo x:Key="TemTexto" />
      <BooleanToVisibilityConverter x:Key="Visivel" />
      <FontFamily x:Key="LunaFonte">Segoe UI Variable Text, Segoe UI</FontFamily>
      <FontFamily x:Key="LunaIcones">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

      <Style x:Key="Titulo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
      </Style>
      <Style x:Key="Apoio" TargetType="TextBlock">
        <Setter Property="Opacity" Value="0.75" />
        <Setter Property="Margin" Value="0,0,0,20" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="TituloSecao" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,10" />
      </Style>
      <Style x:Key="Rotulo" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Opacity" Value="0.85" />
      </Style>
      <Style x:Key="Dica" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.65" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="Cartao" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,0,16" />
      </Style>
      <Style x:Key="Etiqueta" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
