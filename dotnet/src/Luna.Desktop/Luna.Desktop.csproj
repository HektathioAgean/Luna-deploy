<Project Sdk="Microsoft.NET.Sdk">

  <!-- Aplicativo Windows (WPF, tema Fluent). Regras e textos de tela ficam no Luna.Apresentacao. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041: o SkiaSharp.Views.WPF (do ScottPlot) só tem assets modernos para esse alvo; abaixo dele cai no net462 (NU1701). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- O usuário abre Luna.exe; os namespaces continuam Luna.Desktop. -->
    <AssemblyName>Luna</AssemblyName>
    <AssemblyTitle>Luna</AssemblyTitle>
    <Version>1.0.0</Version>
    <!-- A interface é só em português: os recursos do WPF nos outros 12 idiomas não vão para a pasta (−8 MB). -->
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Luna.Apresentacao\Luna.Apresentacao.csproj" />
    <ProjectReference Include="..\Luna.Infrastructure\Luna.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Gráficos do Painel do Cliente (protótipo aprovado em 20/10/2026, LUNA_WPF_PLAN §4.2). -->
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
  </ItemGroup>

</Project>
